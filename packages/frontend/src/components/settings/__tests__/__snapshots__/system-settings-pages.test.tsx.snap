                        class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 transition-colors border border-border text-foreground text-[11px] font-normal"
                      >
                        推荐:通用对话
                      </div>
                      <div
                        class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 transition-colors text-[11px] font-normal bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-200"
                      >
                        供应商标注
                      </div>
                    </div>
                  </td>
                  <td
                    class="h-11 align-middle [&:has([role=checkbox])]:pr-0 py-3 px-3 text-center"
                  >
                    <button
                      aria-checked="false"
                      aria-label="图片理解开关"
                      class="peer inline-flex h-[22px] w-[38px] shrink-0 cursor-pointer items-center rounded-full border transition-colors duration-[160ms] border-border bg-surface-hover data-[state=checked]:border-transparent data-[state=checked]:bg-signal disabled:cursor-not-allowed disabled:opacity-50 scale-75 mx-auto"
                      data-state="unchecked"
                      id="local-phi-3-vision"
                      role="switch"
                      type="button"
                      value="on"
                    >
                      <span
                        class="pointer-events-none block h-[18px] w-[18px] rounded-full bg-surface transition-transform duration-[160ms] data-[state=checked]:translate-x-[18px] data-[state=unchecked]:translate-x-[2px] data-[state=checked]:bg-background"
                        data-state="unchecked"
                      />
                    </button>
                  </td>
                  <td
                    class="h-11 align-middle [&:has([role=checkbox])]:pr-0 py-3 px-3 text-center"
                  >
                    <button
                      aria-checked="true"
                      aria-label="图像生成开关"
                      class="peer inline-flex h-[22px] w-[38px] shrink-0 cursor-pointer items-center rounded-full border transition-colors duration-[160ms] border-border bg-surface-hover data-[state=checked]:border-transparent data-[state=checked]:bg-signal disabled:cursor-not-allowed disabled:opacity-50 scale-75 mx-auto"
                      data-state="checked"
                      id="local-phi-3-image_generation"
                      role="switch"
                      type="button"
                      value="on"
                    >
                      <span
                        class="pointer-events-none block h-[18px] w-[18px] rounded-full bg-surface transition-transform duration-[160ms] data-[state=checked]:translate-x-[18px] data-[state=unchecked]:translate-x-[2px] data-[state=checked]:bg-background"
                        data-state="checked"
                      />
                    </button>
                  </td>
                  <td
                    class="h-11 align-middle [&:has([role=checkbox])]:pr-0 py-3 px-3 text-center"
                  >
                    <span
                      class="text-xs text-muted-foreground"
                    >
                      否
                    </span>
                  </td>
                  <td
                    class="h-11 align-middle [&:has([role=checkbox])]:pr-0 py-3 px-3 text-center"
                  >
                    <button
                      aria-expanded="false"
                      aria-haspopup="menu"
                      class="inline-flex items-center justify-center whitespace-nowrap border border-transparent text-[13px] font-medium transition-colors duration-[160ms] disabled:pointer-events-none disabled:border-transparent disabled:text-ink-tertiary text-muted-foreground hover:bg-surface-hover hover:text-foreground data-[state=open]:bg-surface-hover data-[state=open]:text-foreground disabled:bg-transparent h-7 w-7 rounded-full"
                      data-state="closed"
                      id="radix-:ra:"
                      type="button"
                    >
                      <svg
                        class="w-4 h-4"
                        fill="none"
                        height="24"
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                        width="24"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <circle
                          cx="12"
                          cy="12"
                          r="1"
                        />
                        <circle
                          cx="12"
                          cy="5"
                          r="1"
                        />
                        <circle
                          cx="12"
                          cy="19"
                          r="1"
                        />
                      </svg>
                      <span
                        class="sr-only"
                      >
                        更多操作
                      </span>
                    </button>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
        <div
          class="flex flex-wrap items-center justify-between gap-2 text-xs text-muted-foreground mt-3"
        >
          <div>
            当前筛选 
            2
             个模型，每页 
            80
             个
          </div>
          <div
            class="flex items-center gap-2"
          >
            <button
              class="inline-flex items-center justify-center whitespace-nowrap rounded-md border text-[13px] font-medium transition-colors duration-[160ms] disabled:pointer-events-none disabled:border-transparent disabled:bg-surface-subtle disabled:text-ink-tertiary border-border bg-transparent text-foreground hover:bg-surface-hover h-8 px-3"
              disabled=""
            >
              上一页
            </button>
            <span>
              第 
              1
               / 
              1
               页
            </span>
            <button
              class="inline-flex items-center justify-center whitespace-nowrap rounded-md border text-[13px] font-medium transition-colors duration-[160ms] disabled:pointer-events-none disabled:border-transparent disabled:bg-surface-subtle disabled:text-ink-tertiary border-border bg-transparent text-foreground hover:bg-surface-hover h-8 px-3"
              disabled=""
            >
              下一页
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`;
